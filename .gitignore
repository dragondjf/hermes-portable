# Build artifacts — regenerated by build scripts, never committed.
hermes-portable.tar.gz
hermes-portable.tar.*
hermes-portable/          # the assembled package is built locally / by CI, not in git
*.tar.gz

# Python caches
__pycache__/
*.py[cod]
*.egg-info/
.eggs/

# The checked-out / built hermes-agent source tree (fetched by the official
# installer at build time — do NOT commit the 5000+ upstream files).
hermes-agent/
runtime/

# Per-deploy state (config written by install.sh, uv binary, kanban db, etc.)
home/
home-fresh/
official-hermes/

# Node / JS build artifacts sometimes present in a local checkout
node_modules/
dist/

# Shell history / editor files
*.swp
*~
.DS_Store
